# ---- Vercel (web/) ----
DASHBOARD_PASSWORD=            # shared dashboard password (prototype auth)
SESSION_SECRET=                # openssl rand -hex 32
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=     # server-side only
TWIGA_ORG_ID=                  # id printed by supabase/schema.sql
BRIDGE_SECRET=                 # openssl rand -hex 32 (same on bridge host)
TWIGA_AUDIO_BRIDGE_URL=wss://YOUR-BRIDGE-HOST/stream
TOOLS_SECRET=                  # openssl rand -hex 32
TWIGA_PHONE_NUMBER=+254709221577
TWIGA_VOICE_CALLBACK_URL=https://YOUR-VERCEL-DOMAIN/api/sautikit/voice
SAUTIKIT_API_KEY=
SAUTIKIT_NUMBER_ID=2de4cf96-1ee2-4563-81ec-5e78b9660d42
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
TWIGA_OUTBOUND_ENABLED=false
# ---- Bridge host (Fly/Railway) needs: ELEVENLABS_API_KEY, ELEVENLABS_AGENT_ID, BRIDGE_SECRET, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, TWIGA_ORG_ID ----
# ---- scripts/setup-elevenlabs.mjs also needs TWIGA_PUBLIC_URL (your Vercel URL) ----
